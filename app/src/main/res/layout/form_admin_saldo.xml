<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MONTO (ARS)"
        android:textColor="#D7D7DC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editAdminSaldoMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_auth_input"
        android:hint="Ej. 500000"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777781"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="MOTIVO (OPCIONAL)"
        android:textColor="#D7D7DC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editAdminSaldoMotivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_auth_input"
        android:hint="Ej. Premio sorteo, devolución…"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="120"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777781"
        android:textSize="14sp" />
</LinearLayout>
