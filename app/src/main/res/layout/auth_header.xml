<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_ja" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="62dp"
        android:layout_height="28dp"
        android:contentDescription="Formula 1"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_f1" />

    <ImageView
        android:layout_width="58dp"
        android:layout_height="25dp"
        android:layout_marginStart="12dp"
        android:contentDescription="MotoGP"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_motogp" />

    <ImageView
        android:layout_width="38dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:contentDescription="FIA"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_fia" />

</LinearLayout>
