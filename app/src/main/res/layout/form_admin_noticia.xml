<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÍTULO"
            android:textColor="#D7D7DC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAdminNoticiaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_input"
            android:hint="Título de la noticia"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777781"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="RESUMEN"
            android:textColor="#D7D7DC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAdminNoticiaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_input"
            android:gravity="top"
            android:hint="Bajada corta (opcional)"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="72dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777781"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="IMAGEN"
            android:textColor="#D7D7DC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAdminNoticiaImagen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_input"
            android:hint="https://… o news_featured"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#777781"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="BADGE"
            android:textColor="#D7D7DC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAdminNoticiaBadge"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_input"
            android:hint="UNLOCKED (opcional)"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#777781"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAdminNoticiaDestacada"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="Destacada en portada"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAdminNoticiaPublicada"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:checked="true"
            android:text="Publicada (apagado = borrador)"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
