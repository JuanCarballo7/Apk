<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerEntradas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnEntradasBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GP ARGENTINA · 06 - 08 NOV 2026"
                android:textColor="#E10600"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autódromo Oscar y Juan Gálvez"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mapa -->
    <FrameLayout
        android:id="@+id/contenedorMapa"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_ranking_card">

        <com.example.activiti_main.CircuitMapView
            android:id="@+id/mapaCircuito"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_map_controls"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnMapaCentrar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:contentDescription="Recentrar mapa"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#111111"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnMapaZoomIn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:contentDescription="Acercar"
                android:gravity="center"
                android:text="+"
                android:textColor="#111111"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnMapaZoomOut"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:contentDescription="Alejar"
                android:gravity="center"
                android:text="−"
                android:textColor="#111111"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Categorías -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tabTodas"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:maxLines="1"
            android:text="Todas"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabTribunas"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tribunas"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabGeneral"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:text="General"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHospitality"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:text="Hospitality"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtFiltroZona"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="4dp"
        android:paddingVertical="4dp"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Mostrando: Paddock Club   ✕"
        tools:visibility="visible" />

    <!-- Tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ranking_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_table_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/txtTituloTabla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UBICACIÓN"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRECIO · ARS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEntradas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:itemCount="4"
            tools:listitem="@layout/item_entrada" />
    </LinearLayout>

    <!-- Carrito -->
    <LinearLayout
        android:id="@+id/barraCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cart_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCarritoCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9A9A"
                android:textSize="12sp"
                tools:text="3 entradas en el carrito" />

            <TextView
                android:id="@+id/txtCarritoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="$22.269.762,97" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnVerCarrito"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="VER CARRITO"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
