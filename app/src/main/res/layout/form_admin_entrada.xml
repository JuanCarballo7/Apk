<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PRECIO (ARS)"
        android:textColor="#D7D7DC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editAdminPrecio"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_auth_input"
        android:hint="1850000.00"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#777781" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="STOCK DISPONIBLE"
        android:textColor="#D7D7DC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editAdminStock"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_auth_input"
        android:hint="0"
        android:importantForAutofill="no"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#777781" />
</LinearLayout>
