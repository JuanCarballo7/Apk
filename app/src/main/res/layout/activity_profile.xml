<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnProfileBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Mi perfil"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_ja" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo del perfil"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_ja" />

            <TextView
                android:id="@+id/txtProfileEmailHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#A0A0A8"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="DATOS PERSONALES"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="NOMBRE"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileFirstName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Nombre"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777781" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="APELLIDO"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileLastName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Apellido"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777781" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="EMAIL"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:hint="tu@email.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777781" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#D1131E"
                android:text="GUARDAR DATOS"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="CAMBIAR CONTRASEÑA"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#A0A0A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editProfilePassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Nueva contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777781" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#A0A0A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editProfilePasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Repetir contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777781" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#34343D"
                android:text="CAMBIAR CONTRASEÑA"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressProfile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="#D1131E"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtProfileMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfileLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="34dp"
                android:backgroundTint="#65171B"
                android:text="CERRAR SESIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
