<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E"
    android:orientation="vertical">

    <include layout="@layout/auth_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A31" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Crear cuenta"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Sumate a la comunidad del automovilismo"
                android:textColor="#A0A0A8"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOMBRE"
                        android:textColor="#D7D7DC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="personGivenName"
                        android:background="@drawable/bg_auth_input"
                        android:hint="Tu nombre"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777781" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APELLIDO"
                        android:textColor="#D7D7DC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editLastName"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="personFamilyName"
                        android:background="@drawable/bg_auth_input"
                        android:hint="Tu apellido"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777781" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="EMAIL"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_auth_input"
                android:hint="tu@email.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777781" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CONTRASEÑA"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#A0A0A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Mínimo 8 caracteres"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777781" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CONFIRMAR CONTRASEÑA"
                android:textColor="#D7D7DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#A0A0A8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Repetí tu contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777781" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/checkTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="#D1131E"
                android:text="Acepto los Términos y Condiciones y la Política de Privacidad"
                android:textColor="#B7B7BE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#D1131E"
                android:text="CREAR CUENTA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressRegister"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="14dp"
                android:indeterminateTint="#D1131E"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtRegisterError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnOpenLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="¿Ya tenés cuenta?  Iniciar sesión"
                android:textColor="#D1131E"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
